# Copy to .env. Keep credentials private.
DATABASE_URL=
OPENAI_API_KEY=
VISITOR_COOKIE_SECRET=
APP_ORIGIN=http://localhost:3000

# Enable after configuring credentials and applying database migrations.
PDF_INGESTION_ENABLED=false
OWNED_SOURCE_TEXT_ENABLED=false
OWNED_SOURCE_VOICE_ENABLED=false
YOUTUBE_INGESTION_ENABLED=false

# Use direct locally, supadata on Render. Supadata requires its API key.
YOUTUBE_INGESTION_PROVIDER=direct
SUPADATA_API_KEY=

# Set true for localhost HTTP; leave false on public deployments.
PDF_INGESTION_LOCAL_HTTP=false
YOUTUBE_INGESTION_LOCAL_HTTP=false
