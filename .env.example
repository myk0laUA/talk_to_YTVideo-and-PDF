# Copy to .env and configure privately. Never commit credentials or use NEXT_PUBLIC_ for secrets.
# Generation, build and offline tests do not need live services.
DATABASE_URL=
OPENAI_API_KEY=
SUPADATA_API_KEY=

# Exact browser origin, without a trailing slash. Public deployment requires HTTPS.
APP_ORIGIN=http://localhost:3000
# Generate 32 random bytes encoded as 64 hexadecimal characters:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
VISITOR_COOKIE_SECRET=

# Normal application gates. Both conversation modes use gpt-realtime-2.1.
# Enable only after configuring PostgreSQL, applying migrations and supplying model access.
# PDF extraction itself requires PostgreSQL but does not use an OpenAI key.
PDF_INGESTION_ENABLED=false
OWNED_SOURCE_TEXT_ENABLED=false
OWNED_SOURCE_VOICE_ENABLED=false
# Explicit loopback HTTP opt-in for local development/demo only.
PDF_INGESTION_LOCAL_HTTP=false

# Native English captions. Direct retrieval may be blocked locally or on a host.
# The current hosted release uses supadata; direct needs no managed-provider key.
# Provider: direct, supadata, or auto (auto requires SUPADATA_API_KEY).
YOUTUBE_INGESTION_ENABLED=false
YOUTUBE_INGESTION_PROVIDER=direct
YOUTUBE_INGESTION_LOCAL_HTTP=false
# Auto uses Supadata alone unless direct-first is deliberately enabled.
YOUTUBE_AUTO_DIRECT_FIRST=false
# Operator diagnostic: bypasses both caption-cache reads and writes.
YOUTUBE_CAPTION_CACHE_BYPASS=false

# Isolated diagnostic proof paths; keep disabled for normal application use.
# Proof credentials never authorize uploaded sources.
PROOF_ENABLED=false
REALTIME_ISSUANCE_ENABLED=false
TEXT_PROOF_ENABLED=false
PDF_PROOF_ENABLED=false
PDF_PROOF_LOCAL_HTTP=false
CAPTION_PROOF_ENABLED=false
CAPTION_PROOF_PROVIDER=direct
CAPTION_PROOF_LOCAL_HTTP=false
# Legacy proof-only model setting; does not select either owned-session model.
OPENAI_REALTIME_MODEL=gpt-realtime
