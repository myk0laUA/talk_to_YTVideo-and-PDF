# The shell, Prisma generation, unit tests and build need no credentials.
# Copy to .env; leave values blank until real services are configured.
# Never prefix a secret with NEXT_PUBLIC_ or commit your .env.

# PostgreSQL URL supplied by your database provider (local or Render).
# Required only for database operations. Use provider-required TLS settings.
DATABASE_URL=

# Server-side integrations; the shell does not use these.
OPENAI_API_KEY=
# 10D owned-source server-relayed text. PM enables privately only after review.
# Requires configured owned-source reads, OPENAI_API_KEY and signed visitors.
# Fixed gpt-realtime-2.1 for PDF and YouTube / B / 2048 output / minimal / disabled truncation.
# No size switching, routing-enable flag, cutoff or automatic Mini fallback.
# Both owned modes default to larger, fixed per session, without automatic Mini fallback.
# Voice: WebRTC / Marin / gpt-4o-mini-transcribe / 2048 output / disabled truncation.
# Final server VAD: threshold 0.6 / silence 600ms / response and interruption enabled.
# Voice and text have separate policy revisions; model selection needs no environment setting.
# Larger costs more than Mini; source answers can still contain errors.
# OPENAI_REALTIME_MODEL below controls only the older synthetic proof path.
OWNED_SOURCE_TEXT_ENABLED=false
# Independent owned-source WebRTC voice gate; requires the same owned-read setup.
OWNED_SOURCE_VOICE_ENABLED=false
SUPADATA_API_KEY=
SCRAPECREATORS_API_KEY=

# 02a proof only. PM enables these separately after review; both default off.
PROOF_ENABLED=false
REALTIME_ISSUANCE_ENABLED=false
# Exact browser origin, no trailing slash/path. Production requires HTTPS.
APP_ORIGIN=http://localhost:3000
# Generate 32 random bytes as 64 hex characters through secure secret setup.
# No committed example secret. Rotation invalidates existing anonymous cookies.
VISITOR_COOKIE_SECRET=
# Explicit model required to mint; example only, account access is unverified.
# 07C: exact server budget evidence is separate; both reviewed model identifiers
# remain budget_unavailable until their tokenizer AND Realtime framing are established.
# gpt-realtime is deprecated; the plan's gpt-realtime-2.1 is a separate PM selection.
OPENAI_REALTIME_MODEL=gpt-realtime

# Separately gates the microphone-free proof page and text mint mode.
TEXT_PROOF_ENABLED=false

# Independent caption proof. No OpenAI key or database is used.
CAPTION_PROOF_ENABLED=false
# Explicit single provider, no fallback: direct (default) or supadata (needs SUPADATA_API_KEY).
CAPTION_PROOF_PROVIDER=direct
# Explicit opt-in for loopback HTTP with a production local build; HTTPS elsewhere.
CAPTION_PROOF_LOCAL_HTTP=false

# Independent PDF extraction proof, no database/provider key. No Source is created.
PDF_PROOF_ENABLED=false
PDF_PROOF_LOCAL_HTTP=false

# Independent production PDF storage API. PM applies reviewed migration before enabling.
PDF_INGESTION_ENABLED=false
PDF_INGESTION_LOCAL_HTTP=false

# Independent owned native-caption API; no conversation activation.
# PM applies the reviewed active-source constraint migration before enabling.
# Provider: forced direct, forced supadata, or auto (always needs SUPADATA_API_KEY).
# Auto uses Supadata alone unless separately opted into direct-first below.
YOUTUBE_INGESTION_ENABLED=false
YOUTUBE_INGESTION_PROVIDER=direct
# Server-only; default false because recent hosted direct checks are blocked.
# Auto direct blocked/rate-limit or two consecutive timeout/upstream failures skip direct for 5m.
# Managed rate-limit suppresses automatic misses for 5m; valid cache hits remain usable.
# Quota/unknown limits/auth keep authored errors and require operator action, no retry.
# Cooldowns are process-local, reset on restart/policy rotation, independent per host.
YOUTUBE_AUTO_DIRECT_FIRST=false
YOUTUBE_INGESTION_LOCAL_HTTP=false
# Server-only operator control: skips BOTH cache reads/writes for uncached provider verification.
# Must be true when proving a forced adapter; diagnostic /api/proof-captions is always uncached.
YOUTUBE_CAPTION_CACHE_BYPASS=false
