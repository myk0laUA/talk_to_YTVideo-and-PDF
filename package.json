{
  "name": "talk-to-a-document",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test tests/unit/*.test.ts",
    "test:budget": "node --conditions=react-server --test tests/unit/model-budget.test.ts",
    "test:context": "node --conditions=react-server --test tests/unit/context.test.ts",
    "test:priming": "node --conditions=react-server --test tests/unit/priming.test.ts",
    "test:lifecycle": "node --conditions=react-server --test tests/unit/voice-lifecycle.test.ts",
    "test:interruption": "node --conditions=react-server --test tests/unit/voice-interruption.test.ts",
    "test:transcript": "node --conditions=react-server --test tests/unit/transcript.test.ts",
    "test:transcript-view": "node scripts/verify-transcript-view.mjs",
    "test:smoke": "playwright test",
    "test:text-lifecycle": "node --conditions=react-server --test tests/unit/text-lifecycle.test.ts",
    "test:text": "playwright test --config playwright.text.config.ts",
    "test:voice": "playwright test --config playwright.voice.config.ts",
    "test:captions:mocked": "node scripts/verify-captions-mocked.mjs",
    "test:pdf:http": "node scripts/verify-pdf-http.mjs",
    "test:sources:http": "node scripts/verify-sources-http.mjs",
    "test:youtube:http": "node scripts/verify-youtube-sources-http.mjs",
    "test:captions:cache": "node scripts/verify-caption-cache.mjs",
    "test:captions:coalescing": "node scripts/verify-caption-coalescing.mjs",
    "test:captions:fallback": "node scripts/verify-caption-fallback.mjs",
    "test:source-ui": "node scripts/verify-source-ui.mjs",
    "test:youtube-ui": "node scripts/verify-youtube-ui.mjs",
    "browser:install": "playwright install chromium",
    "browser:cli": "playwright-cli",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:probe": "node --conditions=react-server scripts/verify-db-persistence.ts",
    "proof:captions:local": "node scripts/verify-captions-local.mjs",
    "postinstall": "prisma generate",
    "db:cleanup": "node --conditions=react-server scripts/cleanup-expired.ts",
    "test:cleanup": "node --conditions=react-server --test tests/unit/cleanup.test.ts",
    "test:cleanup:postgres": "node --conditions=react-server scripts/verify-cleanup-postgres.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "next": "16.4.2",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "youtube-transcript-plus": "2.0.3"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "unrs-resolver@1.12.2": true
  }
}
